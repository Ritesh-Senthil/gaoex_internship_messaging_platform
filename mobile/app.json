{
  "expo": {
    "name": "InternHub",
    "slug": "internhub",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "internhub",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1F22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.internhub.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "InternHub needs access to your photo library to share images and videos in messages.",
        "NSCameraUsageDescription": "InternHub needs access to your camera to take photos for messages.",
        "NSMicrophoneUsageDescription": "InternHub needs access to your microphone to record videos."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.internhub.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1F22"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withIosModularHeaders",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "InternHub needs access to your photos to share images in messages.",
          "cameraPermission": "InternHub needs access to your camera to take photos."
        }
      ],
      "expo-document-picker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.543948018812-5nv38bcnot6qd3pecsov6bubtij3ftas"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A84FF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7b7d8aa7-feb3-4708-90f7-9a9ef01c2c97"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/7b7d8aa7-feb3-4708-90f7-9a9ef01c2c97"
    }
  }
}
